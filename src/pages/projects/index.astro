---
import MainLayout from "@layouts/MainLayout.astro";
import Projects from "@components/Projects.astro";
import { CONFIG } from "../../config";
---

<MainLayout title={`Projects — ${CONFIG.name}`} description="A collection of my work and side projects.">
  <main class="py-12">
    <div class="max-w-6xl mx-auto px-6 mb-8">
      <span class="section-label">Portfolio</span>
      <h1 class="font-display font-bold text-[clamp(1.85rem,4.5vw,2.75rem)] text-[var(--text-primary)] leading-tight">All Projects</h1>
    </div>
    <Projects type="all" />
  </main>
</MainLayout>
