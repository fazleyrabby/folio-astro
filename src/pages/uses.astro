---
import MainLayout from "@layouts/MainLayout.astro";
import { Content as UsesContent } from "../content/uses.md";
import { CONFIG } from "../config";
---

<MainLayout title={`Uses — ${CONFIG.name}`} description="Tools and setup I use for my daily work.">
  <main class="max-w-3xl mx-auto px-6 py-12">
    <div class="mb-14">
      <span class="section-label">Setup</span>
      <h1 class="font-display font-bold text-[clamp(1.85rem,4.5vw,2.75rem)] text-[var(--text-primary)] leading-tight">Uses</h1>
      <p class="font-serif italic text-[1.2rem] text-[var(--text-secondary)] mt-4">Tools & setup I use for my daily work.</p>
    </div>
    <article class="prose prose-neutral dark:prose-invert w-full max-w-none prose-p:text-[var(--text-secondary)] prose-p:leading-[1.7] prose-li:text-[var(--text-secondary)] prose-headings:font-display prose-headings:font-bold prose-headings:text-[var(--text-primary)] prose-strong:text-[var(--text-primary)] text-[0.95rem]">
      <UsesContent />
    </article>
  </main>
</MainLayout>
