---
import MainLayout from "@layouts/MainLayout.astro";
import { CONFIG } from "../config";
import { getCollection, render } from "astro:content";

const experiences = await getCollection("experiences");
experiences.sort((a, b) => {
  const da = a.data.timeline ? new Date(a.data.timeline) : new Date(0);
  const db = b.data.timeline ? new Date(b.data.timeline) : new Date(0);
  return db.getTime() - da.getTime();
});
const renderedExp = await Promise.all(
  experiences.map(async (exp) => ({ ...exp, Content: (await render(exp)).Content }))
);

const { resume } = CONFIG;

const skillLine = [
  CONFIG.skills.primary?.length && { label: "Core", items: CONFIG.skills.primary },
  CONFIG.skills.secondary?.length && { label: "Also", items: CONFIG.skills.secondary },
  CONFIG.skills.tools?.length && { label: "Tools", items: CONFIG.skills.tools },
].filter(Boolean) as { label: string; items: string[] }[];
---

<MainLayout title={`Resume — ${CONFIG.name}`} description={`Resume of ${CONFIG.name}, ${CONFIG.title}.`}>
  <main class="max-w-3xl mx-auto px-6 py-10">
    <!-- Page heading + print button (screen only) -->
    <div class="mb-6 flex items-end justify-between gap-4 print:hidden">
      <div>
        <span class="section-label">Resume</span>
        <h1 class="font-display font-bold text-[clamp(1.5rem,3.5vw,2rem)] text-[var(--text-primary)] leading-tight">My CV</h1>
      </div>
      <button id="print-resume" type="button" class="btn-ghost text-xs gap-2 w-fit">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        Download PDF
      </button>
    </div>

    <article class="cv border border-[var(--border)] rounded-[var(--radius)] p-6 sm:p-8 text-[var(--text-primary)]">
      <!-- Header -->
      <header class="cv-head pb-4 mb-5 border-b border-[var(--border)]">
        <h2 class="font-display font-bold text-xl sm:text-2xl leading-tight">{CONFIG.name}</h2>
        <p class="text-[var(--accent)] font-mono text-[0.7rem] uppercase tracking-widest mt-0.5">{CONFIG.title}</p>
        <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-[0.75rem] font-mono text-[var(--text-muted)]">
          {resume?.location && <span>{resume.location}</span>}
          <a href={`mailto:${CONFIG.email}`} class="hover:text-[var(--accent)] transition-colors">{CONFIG.email}</a>
          {CONFIG.social.github && <a href={CONFIG.social.github} target="_blank" rel="noreferrer" class="hover:text-[var(--accent)] transition-colors">GitHub</a>}
          {CONFIG.social.linkedin && <a href={CONFIG.social.linkedin} target="_blank" rel="noreferrer" class="hover:text-[var(--accent)] transition-colors">LinkedIn</a>}
          {CONFIG.social.twitter && <a href={CONFIG.social.twitter} target="_blank" rel="noreferrer" class="hover:text-[var(--accent)] transition-colors">Twitter</a>}
        </div>
      </header>

      <!-- Summary -->
      <section class="cv-section">
        <h3 class="cv-h">Summary</h3>
        <p class="text-[0.85rem] text-[var(--text-secondary)] leading-snug">{CONFIG.bio}</p>
      </section>

      <!-- Experience -->
      {renderedExp.length > 0 && (
        <section class="cv-section">
          <h3 class="cv-h">Experience</h3>
          <div class="space-y-3.5">
            {renderedExp.map((exp) => (
              <div>
                <div class="flex flex-wrap items-baseline justify-between gap-x-3 leading-tight">
                  <p class="text-[0.9rem]">
                    <span class="font-display font-semibold">{exp.data.title}</span>
                    <span class="text-[var(--text-muted)] mx-1.5">·</span>
                    <span class="italic text-[var(--text-secondary)]">{exp.data.role}</span>
                  </p>
                  <span class="font-mono text-[0.65rem] uppercase tracking-wider text-[var(--text-muted)] shrink-0">
                    {exp.data.from} — {exp.data.to}
                  </span>
                </div>
                <div class="cv-prose text-[0.82rem] text-[var(--text-secondary)] mt-1">
                  <exp.Content />
                </div>
                {exp.data.skills && (
                  <p class="font-mono text-[0.65rem] text-[var(--text-muted)] mt-1">{exp.data.skills}</p>
                )}
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Skills (single compact block) -->
      {skillLine.length > 0 && (
        <section class="cv-section">
          <h3 class="cv-h">Skills</h3>
          <dl class="text-[0.82rem] leading-snug space-y-1">
            {skillLine.map((row) => (
              <div class="flex gap-3">
                <dt class="font-mono text-[0.65rem] uppercase tracking-wider text-[var(--text-muted)] w-12 shrink-0 pt-0.5">{row.label}</dt>
                <dd class="text-[var(--text-secondary)]">{row.items.join(" · ")}</dd>
              </div>
            ))}
          </dl>
        </section>
      )}

      <!-- Education -->
      {resume?.education?.length > 0 && (
        <section class="cv-section">
          <h3 class="cv-h">Education</h3>
          <div class="space-y-2">
            {resume.education.map((e) => (
              <div>
                <div class="flex flex-wrap items-baseline justify-between gap-x-3 leading-tight">
                  <p class="text-[0.9rem]">
                    <span class="font-display font-semibold">{e.school}</span>
                    <span class="text-[var(--text-muted)] mx-1.5">·</span>
                    <span class="italic text-[var(--text-secondary)]">{e.degree}</span>
                  </p>
                  <span class="font-mono text-[0.65rem] uppercase tracking-wider text-[var(--text-muted)] shrink-0">
                    {e.from} — {e.to}
                  </span>
                </div>
                {e.notes && <p class="text-[0.8rem] text-[var(--text-secondary)] leading-snug mt-0.5">{e.notes}</p>}
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Certifications -->
      {resume?.certifications?.length > 0 && (
        <section class="cv-section">
          <h3 class="cv-h">Certifications</h3>
          <ul class="space-y-1 text-[0.82rem]">
            {resume.certifications.map((c) => (
              <li class="flex flex-wrap items-baseline justify-between gap-x-3 leading-tight">
                <span>
                  {c.link ? (
                    <a href={c.link} target="_blank" rel="noreferrer" class="font-display font-semibold hover:text-[var(--accent)] transition-colors">{c.name}</a>
                  ) : (
                    <span class="font-display font-semibold">{c.name}</span>
                  )}
                  <span class="text-[var(--text-muted)] mx-1.5">·</span>
                  <span class="italic text-[var(--text-secondary)]">{c.issuer}</span>
                </span>
                <span class="font-mono text-[0.65rem] uppercase tracking-wider text-[var(--text-muted)] shrink-0">{c.year}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- Awards -->
      {resume?.awards?.length > 0 && (
        <section class="cv-section">
          <h3 class="cv-h">Awards</h3>
          <ul class="space-y-1 text-[0.82rem] text-[var(--text-secondary)]">
            {resume.awards.map((a) => (
              <li>
                <span class="font-display font-semibold text-[var(--text-primary)]">{a.title}</span>
                <span class="text-[var(--text-muted)] mx-1.5">·</span>
                <span class="italic">{a.org}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- Languages + Interests inline -->
      {(resume?.languages?.length > 0 || resume?.interests?.length > 0) && (
        <section class="cv-section grid sm:grid-cols-2 gap-x-8 gap-y-3">
          {resume.languages?.length > 0 && (
            <div>
              <h3 class="cv-h">Languages</h3>
              <p class="text-[0.82rem] text-[var(--text-secondary)] leading-snug">
                {resume.languages.map(l => `${l.name} (${l.level})`).join(" · ")}
              </p>
            </div>
          )}
          {resume.interests?.length > 0 && (
            <div>
              <h3 class="cv-h">Interests</h3>
              <p class="text-[0.82rem] text-[var(--text-secondary)] leading-snug">{resume.interests.join(" · ")}</p>
            </div>
          )}
        </section>
      )}
    </article>

    <p class="font-mono text-[0.7rem] text-center text-[var(--text-muted)] mt-6 print:hidden">
      Edit <code class="text-[var(--accent)]">src/config.ts → CONFIG.resume</code> · click <strong>Download PDF</strong> to print this CV through your browser.
    </p>
  </main>
</MainLayout>

<script>
  document.getElementById("print-resume")?.addEventListener("click", () => window.print());
</script>

<style>
  .cv-h {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.55rem;
  }

  .cv-section {
    padding-top: 0.85rem;
    padding-bottom: 0.85rem;
    border-top: 1px solid var(--border);
  }
  .cv-section:first-of-type {
    border-top: 0;
    padding-top: 0;
  }

  .cv-prose :global(ul) {
    list-style: disc;
    padding-left: 1rem;
    margin: 0.2rem 0;
  }
  .cv-prose :global(li) {
    margin-bottom: 0.15rem;
    line-height: 1.45;
  }
  .cv-prose :global(li::marker) {
    color: var(--accent);
  }
  .cv-prose :global(p) {
    margin: 0.2rem 0;
  }

  @media print {
    @page {
      size: A4;
      margin: 12mm;
    }

    :global(html),
    :global(body) {
      background: #ffffff !important;
      color: #111 !important;
      font-size: 10.5pt !important;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    :global(header.sticky),
    :global(footer),
    :global(nav),
    :global(#scroll-to-top),
    :global(.hero-cursor-light),
    :global(.editorial-break) {
      display: none !important;
    }

    main {
      max-width: 100% !important;
      padding: 0 !important;
      margin: 0 !important;
    }

    .cv {
      border: none !important;
      padding: 0 !important;
      border-radius: 0 !important;
      box-shadow: none !important;
      color: #111 !important;
    }

    .cv-head {
      border-color: #222 !important;
      padding-bottom: 8px !important;
      margin-bottom: 10px !important;
    }

    .cv-section {
      border-color: #ddd !important;
      padding: 8px 0 !important;
      page-break-inside: avoid;
      break-inside: avoid;
    }

    .cv-h {
      color: #555 !important;
      margin-bottom: 4px !important;
    }

    a {
      color: inherit !important;
      text-decoration: none !important;
    }

    h2, h3, .font-display {
      color: #111 !important;
    }

    .text-\[var\(--text-secondary\)\],
    .text-\[var\(--text-muted\)\],
    .text-\[var\(--text-primary\)\] {
      color: #222 !important;
    }
  }
</style>
