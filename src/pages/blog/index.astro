---
import MainLayout from "@layouts/MainLayout.astro";
import { CONFIG } from "../../config";
import { getCollection } from "astro:content";
import { url } from "@lib/url";

const allPosts = await getCollection("blog");
allPosts.sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime());
---

<MainLayout title={`Blog — ${CONFIG.name}`} description="Articles and thoughts on software development.">
  <main class="max-w-3xl mx-auto px-6 py-12">
    <div class="mb-14">
      <span class="section-label">Writing</span>
      <h1 class="font-display font-bold text-[clamp(1.85rem,4.5vw,2.75rem)] text-[var(--text-primary)] leading-tight">Blog</h1>
      <p class="font-serif italic text-[1.2rem] text-[var(--text-secondary)] mt-4">Thoughts on code, tools, and craft.</p>
    </div>

    <div class="post-list border-t border-[var(--border)]">
      {allPosts.map((post, i) => (
        <a href={url(`/blog/${post.id}`)} class="post-row flex flex-col sm:flex-row sm:items-center py-4 sm:py-3 border-b border-[var(--border)] group transition-all duration-300 hover:bg-[var(--accent-dim)] hover:pl-4">
          <div class="flex items-start gap-4 sm:gap-6 flex-1 min-w-0">
            <span class="post-number font-mono text-[0.7rem] text-[var(--text-muted)] group-hover:text-[var(--accent)] transition-colors shrink-0">
              {String(i + 1).padStart(2, "0")}
            </span>
            <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-6 min-w-0">
              <span class="post-date font-mono text-[0.68rem] text-[var(--text-muted)] shrink-0">
                {new Date(post.data.publishedAt).toLocaleDateString("en-US", { month: "short", day: "2-digit", year: "numeric" })}
              </span>
              <span class="post-title font-display font-semibold text-[1.02rem] text-[var(--text-primary)] group-hover:text-[var(--text-primary)] truncate">
                {post.data.title}
              </span>
            </div>
          </div>
          <span class="font-mono text-[var(--text-secondary)] group-hover:text-[var(--accent)] group-hover:translate-x-1 transition-all mt-2 sm:mt-0 ml-auto hidden sm:inline-block">→</span>
        </a>
      ))}
    </div>
  </main>
</MainLayout>
