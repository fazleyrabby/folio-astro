---
import { getCollection } from 'astro:content';
import { url } from "@lib/url";

const allPosts = await getCollection('blog');
allPosts.sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime());
const latestPosts = allPosts.slice(0, 4);
---

<section id="posts" class="py-10">
  <div class="max-w-6xl mx-auto px-6">
    <div class="flex items-center gap-6 mb-8">
      <div>
        <span class="section-label">Writing</span>
        <h2 class="reveal-heading text-[var(--text-primary)] font-display font-bold text-[clamp(1.4rem,3.5vw,2rem)] leading-tight">Latest Posts</h2>
      </div>
      <div class="flex-1 hidden md:block h-[1px] bg-[var(--accent)] opacity-20 dark:opacity-30"></div>
    </div>

    <div class="post-list border-t border-[var(--border)]">
      {latestPosts.map((post, i) => (
        <a href={url(`/blog/${post.id}`)} class="post-row flex flex-col sm:flex-row sm:items-center py-4 sm:py-3 border-b border-[var(--border)] group transition-all duration-300 hover:bg-[var(--accent-dim)] hover:pl-4">
          <div class="flex items-start gap-4 sm:gap-6 flex-1 min-w-0">
            <span class="font-mono text-[0.7rem] text-[var(--text-muted)] group-hover:text-[var(--accent)] transition-colors shrink-0">
              {String(i + 1).padStart(2, "0")}
            </span>
            <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-6 min-w-0">
              <span class="font-mono text-[0.68rem] text-[var(--text-muted)] shrink-0">
                {new Date(post.data.publishedAt).toLocaleDateString("en-US", { month: "short", day: "2-digit", year: "numeric" })}
              </span>
              <span class="font-display font-semibold text-[1.02rem] text-[var(--text-primary)] truncate">
                {post.data.title}
              </span>
            </div>
          </div>
          <span class="font-mono text-[var(--text-secondary)] group-hover:text-[var(--accent)] group-hover:translate-x-1 transition-all mt-2 sm:mt-0 ml-auto hidden sm:inline-block">→</span>
        </a>
      ))}
    </div>

    {latestPosts.length === 0 && (
      <div class="text-center py-12">
        <p class="text-[var(--text-muted)] font-mono text-xs">No posts yet. Add markdown files to src/content/blog/</p>
      </div>
    )}

    {latestPosts.length > 0 && (
      <div class="mt-6 text-center">
        <a href={url("/blog")} class="btn-ghost">View All Posts</a>
      </div>
    )}
  </div>
</section>
