---
import { CONFIG } from "../config";
---

<section id="contact-cta" class="py-24 relative overflow-hidden">
  <div class="absolute inset-0 z-0 opacity-10 pointer-events-none">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-accent rounded-full blur-[120px]"></div>
  </div>

  <div class="max-w-6xl mx-auto px-6 relative z-10 text-center">
    <div class="inline-block mb-6">
      <span class="section-label">Contact</span>
    </div>

    <h2 class="font-display text-[clamp(2.5rem,8vw,5rem)] leading-[1.05] mb-8 text-[var(--text-primary)]">
      Have a project<br />
      <span class="italic text-[var(--accent)]">in mind?</span>
    </h2>

    <p class="font-sans text-[var(--text-secondary)] text-lg max-w-xl mx-auto mb-12 opacity-90">
      I'm always open to discussing new projects, ideas, or opportunities. Let's build something great together.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-6 mt-12">
      <a href={`mailto:${CONFIG.email}`} class="btn-primary flex items-center gap-2 group px-8 py-4 text-lg">
        Say Hello
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
      </a>
      <a href="/resume" class="btn-ghost px-8 py-4 text-lg">View Resume</a>
    </div>

    <div class="mt-20 pt-10 border-t border-border flex flex-wrap justify-center gap-x-12 gap-y-6">
      {CONFIG.social.github && (
        <a href={CONFIG.social.github} target="_blank" rel="noopener noreferrer" class="font-mono text-[0.7rem] uppercase tracking-widest text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors">GitHub</a>
      )}
      {CONFIG.social.linkedin && (
        <a href={CONFIG.social.linkedin} target="_blank" rel="noopener noreferrer" class="font-mono text-[0.7rem] uppercase tracking-widest text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors">LinkedIn</a>
      )}
      {CONFIG.social.twitter && (
        <a href={CONFIG.social.twitter} target="_blank" rel="noopener noreferrer" class="font-mono text-[0.7rem] uppercase tracking-widest text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors">Twitter</a>
      )}
    </div>
  </div>
</section>

<style>
  #contact-cta { background: transparent; }
</style>
