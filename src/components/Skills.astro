---
import { CONFIG } from "../config";
---

<section id="skills" class="py-10 overflow-hidden">
  <div class="max-w-6xl mx-auto px-6">
    <div class="flex items-center gap-6 mb-8">
      <div>
        <span class="section-label">Expertise</span>
        <h2 class="reveal-heading text-[var(--text-primary)] font-display font-bold text-[clamp(1.4rem,3.5vw,2rem)] leading-tight">Skills & Tools</h2>
      </div>
      <div class="flex-1 hidden md:block h-[1px] bg-accent opacity-20 dark:opacity-30"></div>
    </div>
  </div>

  <!-- Marquee -->
  <div class="marquee-track">
    <div class="marquee-inner marquee-inner--left">
      {[...CONFIG.skills.primary, ...CONFIG.skills.secondary, ...CONFIG.skills.primary, ...CONFIG.skills.secondary].map(item => (
        <div class="marquee-item">{item.toUpperCase()}</div>
      ))}
    </div>
  </div>
  <div class="marquee-track">
    <div class="marquee-inner marquee-inner--right">
      {[...CONFIG.skills.tools, ...CONFIG.skills.primary, ...CONFIG.skills.tools, ...CONFIG.skills.primary].map(item => (
        <div class="marquee-item">{item.toUpperCase()}</div>
      ))}
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-6 mt-8">
    <div class="border-t border-border">
      <div class="skills-row flex flex-col md:flex-row md:items-start group transition-colors hover:bg-[var(--accent-dim)] px-4 -mx-4">
        <div class="skills-cat w-full md:w-[180px] shrink-0">Primary</div>
        <div class="skills-val flex-1">{CONFIG.skills.primary.join(", ").toUpperCase()}</div>
      </div>
      <div class="skills-row flex flex-col md:flex-row md:items-start group transition-colors hover:bg-[var(--accent-dim)] px-4 -mx-4">
        <div class="skills-cat w-full md:w-[180px] shrink-0">Frameworks</div>
        <div class="skills-val flex-1">{CONFIG.skills.secondary.join(", ").toUpperCase()}</div>
      </div>
      <div class="skills-row flex flex-col md:flex-row md:items-start group transition-colors hover:bg-[var(--accent-dim)] px-4 -mx-4">
        <div class="skills-cat w-full md:w-[180px] shrink-0">Tools</div>
        <div class="skills-val flex-1">{CONFIG.skills.tools.join(", ").toUpperCase()}</div>
      </div>
    </div>
  </div>
</section>
