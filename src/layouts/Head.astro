---
import { CONFIG } from "../config";
---

<head>
  <meta charset="utf-8" />
  <title>{Astro.props.title ?? `${CONFIG.name} — ${CONFIG.title}`}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <meta name="description" content={Astro.props.description ?? CONFIG.site.description} />

  <!-- OG / Social -->
  <meta property="og:title" content={Astro.props.ogTitle ?? Astro.props.title ?? CONFIG.name} />
  <meta property="og:description" content={Astro.props.ogDescription ?? Astro.props.description ?? CONFIG.site.description} />
  <meta property="og:image" content={Astro.props.ogImage ?? CONFIG.site.ogImage} />
  <meta property="og:url" content={Astro.props.ogUrl ?? `${CONFIG.site.url}${Astro.url.pathname}`} />
  <meta property="og:type" content={Astro.props.ogType ?? "website"} />
  <meta name="twitter:card" content={Astro.props.twitterCard ?? "summary_large_image"} />
  <meta name="twitter:title" content={Astro.props.twitterTitle ?? Astro.props.title ?? CONFIG.name} />
  <meta name="twitter:description" content={Astro.props.twitterDescription ?? Astro.props.description ?? CONFIG.site.description} />
  <meta name="twitter:image" content={Astro.props.twitterImage ?? CONFIG.site.ogImage} />
  {Astro.props.articlePublishedTime && <meta property="article:published_time" content={Astro.props.articlePublishedTime} />}
  {Astro.props.articleModifiedTime && <meta property="article:modified_time" content={Astro.props.articleModifiedTime} />}
  {Astro.props.articleTags && Astro.props.articleTags.map((tag: string) => <meta property="article:tag" content={tag} />)}

  <link rel="canonical" href={Astro.props.ogUrl ?? `${CONFIG.site.url}${Astro.url.pathname}`} />
  <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Spectral:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;0,800;1,200;1,300;1,400;1,500;1,600;1,700;1,800&display=swap" rel="stylesheet" />

  <!-- Flash-of-wrong-theme prevention -->
  <script is:inline>
    ;(function() {
      var t = localStorage.getItem("color-mode") || "dark";
      if (t === "dark") {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
    })();
  </script>

  <!-- Critical styles to prevent layout shift -->
  <style is:inline>
    :root {
      --bg-base: #fafaf9;
      --text-primary: #1c1917;
      --accent: #E8823A;
      --font-display: "Spectral", serif;
      --font-sans: "DM Sans", sans-serif;
      --font-mono: "JetBrains Mono", monospace;
    }
    .dark {
      --bg-base: #080808;
      --text-primary: #F0EDE8;
    }
    body { background-color: var(--bg-base); color: var(--text-primary); margin: 0; }
    .hero-section { min-height: 65svh; display: flex; align-items: center; background-color: var(--bg-base); }
  </style>
</head>
