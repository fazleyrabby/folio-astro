---
import { CONFIG } from "../config";
import ThemeIcon from "@components/ThemeIcon.astro";
---

<header class="sticky top-0 z-50 w-full backdrop-blur-xl border-b border-[var(--border)]"
  style="background: color-mix(in srgb, var(--bg-base) 85%, transparent);">
  <nav class="max-w-6xl mx-auto px-6 py-3">
    <div class="flex items-center justify-between">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 group">
        <span class="text-xl text-[var(--text-primary)] font-display font-bold tracking-tight">
          {CONFIG.name.split(" ")[0]}<span class="text-[var(--accent)]">.</span>
        </span>
      </a>

      <!-- Desktop nav -->
      <div class="hidden md:flex items-center gap-8">
        {CONFIG.nav.map(item => (
          <a href={item.href}
            class="text-[0.75rem] font-mono uppercase tracking-[0.08em] text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors relative py-1">
            {item.label}
          </a>
        ))}
        <div class="ml-2 pl-4 border-l border-[var(--border)] flex items-center">
          <ThemeIcon />
        </div>
      </div>

      <!-- Mobile -->
      <div class="flex md:hidden items-center gap-3">
        <ThemeIcon />
        <button id="mobile-menu-btn" aria-label="Toggle menu"
          class="p-2 text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden md:hidden py-4 border-t border-[var(--border)] mt-3">
      <div class="flex flex-col gap-4">
        {CONFIG.nav.map(item => (
          <a href={item.href}
            class="text-[0.75rem] font-mono uppercase tracking-[0.08em] text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors">
            {item.label}
          </a>
        ))}
      </div>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
